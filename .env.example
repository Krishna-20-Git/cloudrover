PORT=3000
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=
MQTT_PASSWORD=
ROVER_ID=rover1
# Set this to the ESP32-CAM's stream endpoint once the camera exists.
# Typical ESP32-CAM web-server stream URL ends in /stream.
CAMERA_STREAM_URL=
# Keep false until you have verified the camera endpoint is reachable from this laptop.
CAMERA_PROXY_ENABLED=false
